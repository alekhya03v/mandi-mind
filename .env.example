# Use the included fixture for a dependable local demo.
USE_SAMPLE_DATA=true
# Free key from data.gov.in. Required only when USE_SAMPLE_DATA=false.
DATA_GOV_API_KEY=
# auto selects a configured provider. Set openai or anthropic to choose explicitly.
LLM_PROVIDER=auto
# Optional model names. Code defaults are used when blank.
OPENAI_MODEL=
ANTHROPIC_MODEL=
# Add one real provider key for LLM-written wording. The app still works without one.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
